# PrediCitas CRP · backend · variables de entorno (contratos/comun.json → variables_entorno_backend)
# Para arrancar con .venv: copiar a backend/.env y ajustar.
# Con Docker Compose no hace falta: docker-compose.yml las define a partir del .env de la raíz.
# ATENCIÓN: los valores de ejemplo son SOLO para desarrollo local; no son secretos reales.

ENVIRONMENT=local

# Conexión de la aplicación con el rol predicitas_app (D-015). Obligatoria.
DATABASE_URL=postgresql+psycopg://predicitas_app:predicitas_app_dev@localhost:5432/predicitas
# Conexión con el rol dueño del esquema; la usan Alembic y los scripts.
# Si se deja vacía o se borra, Alembic usa DATABASE_URL.
DATABASE_URL_MIGRACIONES=postgresql+psycopg://predicitas_owner:predicitas_owner_dev@localhost:5432/predicitas

# Firma de los JWT. Obligatoria. En un ambiente real: cadena aleatoria larga.
SECRET_KEY=solo-desarrollo-local-cambiar-esta-clave-0123456789
JWT_ALGORITHM=HS256
# Expiración de la sesión en minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Bloqueo por intentos fallidos de login.
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=15
LOGIN_BLOQUEO_MINUTOS=15

# Motor de IA (servicio de inferencia o simulador). Fuera de Docker: http://localhost:8100
IA_URL=http://ia:8100
IA_API_KEY=
IA_TIMEOUT_SEGUNDOS=5
# Corte entre riesgo BAJO y MEDIO.
IA_CORTE_MEDIO=0.30

# true = las intervenciones se calculan pero no se envían.
INTERVENCION_MODO_SOMBRA=false

# Orígenes permitidos por CORS, separados por comas.
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173
